# UI Backend Configuration
UI_BACKEND_PORT=5000
UI_BACKEND_HOST=0.0.0.0
AI_BACKEND_URL=http://ai-backend:5001

# AI Backend Configuration
AI_BACKEND_PORT=5001
AI_BACKEND_HOST=0.0.0.0

# YOLOv3 Configuration
